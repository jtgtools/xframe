{
  "name": "@jtgtools/xframe",
  "version": "0.0.2",
  "description": "Linear-static 3D structural analysis: frames, trusses, and springs.",
  "keywords": [
    "finite-element",
    "frames",
    "linear-static",
    "solver",
    "springs",
    "structural-analysis",
    "trusses"
  ],
  "license": "MIT",
  "author": "",
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "verify": "vitest run verification",
    "verify:opensees": "node scripts/verify-opensees.mjs",
    "regenerate:opensees": "node scripts/regenerate-opensees-reference.mjs",
    "check:runtime": "node scripts/check-runtime-imports.mjs",
    "benchmark": "npm run build && node scripts/run-benchmarks.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run coverage && npm run build && npm run check:runtime"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "@vitest/coverage-v8": "5.0.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.12.1"
}
